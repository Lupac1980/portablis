+    needle = re.sub(r"[^a-z0-9]", "", (name or "").lower())
+    if len(needle) < 4:
+        return ""
+    for base in filter(os.path.isdir, bases):
+        for lnk in glob.glob(os.path.join(base, "**", "*.lnk"), recursive=True):
+            target = _lnk_target(lnk)
+            if not target:
